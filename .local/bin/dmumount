#!/bin/sh

# A $LAUNCHER prompt to unmount drives.
# Provides you with mounted partitions, select one to unmount.
# Drives mounted at /, /boot and /home will not be options to unmount.

launcher=$LAUNCHER

drives=$(lsblk -nrpo "name,pkname,size,mountpoint" \
    | awk '$4!~/\/boot|\/home$|SWAP/ && length($4)>1 {printf "%s %s (%s)\n",$1,$2,$3}')

[ -z "$drives" ] && echo "No drives to unmount." && exit

chosen="$(echo "$drives" | $LAUNCHER -i -p "Unmount which drive?")" || exit 1
part="$(echo "$chosen" | awk '{print $1}')"
parent="$(echo "$chosen" | awk '{print $2}')"

[ -z "$part" ] && exit

# Unmount
if sudo -A umount "$part"; then
    notify-send --expire-time=15000 "USB unmounting" "$part unmounted."

    answer="$(printf "No\nYes" | $launcher -i -p "Power off $parent? (default: No)")"

    if [ "$answer" = "Y" ] || [ "$answer" = "Yes" ]; then
        sudo -A udisksctl power-off -b "$parent" \
            && notify-send --expire-time=15000 "USB power-off" "$parent powered off."
    fi
fi
